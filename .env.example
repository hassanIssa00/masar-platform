ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Production auth/session secrets. Required on Vercel Production.
# SESSION_SECRET must be a long random secret. Do not use a static fallback in production.
SESSION_SECRET=

# Bcrypt hash for the protected doctor account dr.ismail@masar.com.
# Store only the hash, never the plain password.
OWNER_PASSWORD_HASH=

# Firebase Admin server credentials for cloud accounts, reports, students, and generated logins.
# Prefer one JSON value in Vercel as FIREBASE_SERVICE_ACCOUNT_KEY.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Alternative Firebase Admin split variables if FIREBASE_SERVICE_ACCOUNT_KEY is not used.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini server-side AI. Put one or more keys separated by comma or new line in Vercel/local env.
# Do not commit real keys to Git.
GEMINI_API_KEYS=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
